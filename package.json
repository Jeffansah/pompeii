{
  "name": "pompeii",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "workspace": "pnpm --filter @pompeii/workspace dev",
    "marketing": "pnpm --filter @pompeii/marketing dev",
    "convex": "convex dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p convex/tsconfig.json",
    "test": "turbo run test && vitest run --config convex/vitest.config.ts",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@pompeii/errors": "workspace:*",
    "@pompeii/eslint-config": "workspace:*",
    "@pompeii/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "convex": "^1.31.0",
    "convex-test": "^0.0.55",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.6",
    "@convex-dev/workpool": "^0.4.9",
    "@vllnt/convex-invitations": "0.1.0-canary.26bf80f",
    "better-auth": "~1.6.29",
    "convex-helpers": "^0.1.123"
  }
}
