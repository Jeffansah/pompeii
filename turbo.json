{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "VITE_CONVEX_URL",
    "VITE_CONVEX_SITE_URL",
    "VITE_SITE_URL",
    "CONVEX_URL",
    "CONVEX_SITE_URL",
    "SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
